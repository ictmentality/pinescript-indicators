tpd_bull_body = input.color(color.new(color.blue, 50), "Bull Body", inline="tpd_body", group=group_tpd_adv)
tpd_bear_body = input.color(color.new(color.red, 50), "Bear Body", inline="tpd_body", group=group_tpd_adv)

var label[] tpd_labels = array.new<label>()
tpd_vis_limit_sec = timeframe.in_seconds(tpd_vis_limit)
bool tpd_is_visible = na(tpd_vis_limit_sec) ? true : timeframe.in_seconds(timeframe.period) >= tpd_vis_limit_sec

group_tpd_debug = "TPD Debug"
show_tpd_debug = input.bool(true, "Show Debug Window", group=group_tpd_debug)

// ---------------------------------------------------------------
// FUNCTION: DYAD TPD (2 Pairs)
// ---------------------------------------------------------------
f_tpd(_htf, _show_tpd, _size) =>
    var bool bull_tpd_out = false
    var bool bear_tpd_out = false
    var label lblbear = na
    var label lblbull = na
    bull_tpd_out := false
    bear_tpd_out := false

    [mh2,ml2,mc2,mo2,mt2,mh1,ml1,mc1,mo1,mt1,mh0,ml0,mc0,mo0,mt0,mup1,mdw1,ml1t,mh1t] = f_live_sym(close,open,high,low,time,_htf)
    [oh2,ol2,oc2,oo2,ot2,oh1,ol1,oc1,oo1,ot1,oh0,ol0,oc0,oo0,ot0,oup1,odw1,ol1t,oh1t] = f_live_sym(xc0,xo0,xh0,xl0,xt0,_htf)

    if _show_tpd and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(_htf)
        arr_crack1 = array.from(mc1 > mo1, oc1 > oo1)
        crack1 = not array.every(arr_crack1) and array.some(arr_crack1)
        arr_crack2 = array.from(mc2 > mo0 , oc2 > oo0)
        crack2 = not array.every(arr_crack2) and array.some(arr_crack2)
        tpd = crack1 and crack2

        lws0 = array.from(ml2,ml1,ml0), lws1 = array.from(ol2,ol1,ol0)
        con_lws0 = array.min(lws0) == ml1, con_lws1 = array.min(lws1) == ol1
        con_lowx = array.from(con_lws0, con_lws1)
        con_low  = array.some(con_lowx)

        hgh0 = array.from(mh2,mh1,mh0), hgh1 = array.from(oh2,oh1,oh0)
        con_hgh0 = array.max(hgh0) == mh1, con_hgh1 = array.max(hgh1) == oh1
        con_hghx = array.from(con_hgh0, con_hgh1)
        con_hgh  = array.some(con_hghx)

        bear_tpd = con_hgh and tpd
        bull_tpd = con_low and tpd
        [bull_smt, bear_smt] = f_smt_pair(ml1, ml0, mh1, mh0, ol1, ol0, oh1, oh0)
        if tpd_use_smt_filter
            bull_tpd := bull_tpd and bull_smt
            bear_tpd := bear_tpd and bear_smt

        if bear_tpd and tpd_show_icons
            lblbear := label.new(mh1t, mh1, text=f_text(_htf)+ '\n' + tpd_bear_shape, xloc=xloc.bar_time, yloc=yloc.abovebar, color=color.new(color.gray, 100), size=_size, textcolor=tpd_bear_color, tooltip="Bearish TPD (Structure)", text_font_family = target_font)
            array.push(tpd_labels, lblbear)
            if array.size(tpd_labels) > max_tpd_bars
                label.delete(array.shift(tpd_labels))
        if bull_tpd and tpd_show_icons
            lblbull := label.new(ml1t, ml1, text=tpd_bull_shape+ '\n'+ f_text(_htf), xloc=xloc.bar_time, yloc=yloc.belowbar, color=color.new(color.gray, 100), size=_size, textcolor=tpd_bull_color, tooltip="Bullish TPD (Structure)", text_font_family = target_font)
            array.push(tpd_labels, lblbull)
            if array.size(tpd_labels) > max_tpd_bars
                label.delete(array.shift(tpd_labels))

        bear_tpd_out := bear_tpd
        bull_tpd_out := bull_tpd

    [bull_tpd_out, bear_tpd_out]

// ---------------------------------------------------------------
// FUNCTION: TRIAD TPD (3 Pairs)
// ---------------------------------------------------------------
f_tpd_triad(_htf, _show_tpd, _size)=>
    var bool bull_tpd_out = false
    var bool bear_tpd_out = false
    var label lblbear = na
    var label lblbull = na
    bull_tpd_out := false
    bear_tpd_out := false

    [mh2,ml2,mc2,mo2,mt2,mh1,ml1,mc1,mo1,mt1,mh0,ml0,mc0,mo0,mt0,mup1,mdw1,ml1t,mh1t] = f_live_sym(close,open,high,low,time,_htf)
    [oh2,ol2,oc2,oo2,ot2,oh1,ol1,oc1,oo1,ot1,oh0,ol0,oc0,oo0,ot0,oup1,odw1,ol1t,oh1t] = f_live_sym(xc0,xo0,xh0,xl0,xt0,_htf)
    [ph2,pl2,pc2,po2,pt2,ph1,pl1,pc1,po1,pt1,ph0,pl0,pc0,po0,pt0,pup1,pdw1,pl1t,ph1t] = f_live_sym(yc0,yo0,yh0,yl0,yt0,_htf)

    if _show_tpd and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(_htf)
        arr_crack1 = array.from(mc1 > mo1, oc1 > oo1, pc1 > po1)
        crack1 = not array.every(arr_crack1) and array.some(arr_crack1)
        arr_crack2 = array.from(mc2 > mo0 , oc2 > oo0, pc2 > po0)
        crack2 = not array.every(arr_crack2) and array.some(arr_crack2)
        tpd = crack1 and crack2

        lws0 = array.from(ml2,ml1,ml0), lws1 = array.from(ol2,ol1,ol0), lws2 = array.from(pl2,pl1,pl0)
        con_lws0 = array.min(lws0) == ml1, con_lws1 = array.min(lws1) == ol1, con_lws2 = array.min(lws2) == pl1
        con_lowx = array.from(con_lws0, con_lws1,con_lws2)
        con_low  = array.some(con_lowx)

        hgh0 = array.from(mh2,mh1,mh0), hgh1 = array.from(oh2,oh1,oh0), hgh2 = array.from(ph2,ph1,ph0)
        con_hgh0 = array.max(hgh0) == mh1, con_hgh1 = array.max(hgh1) == oh1, con_hgh2 = array.max(hgh2) == ph1
        con_hghx = array.from(con_hgh0, con_hgh1, con_hgh2)
        con_hgh  = array.some(con_hghx)

        bear_tpd = con_hgh and tpd
        bull_tpd = con_low and tpd
        [bull_smt, bear_smt] = f_smt_pair(ml1, ml0, mh1, mh0, ol1, ol0, oh1, oh0)
        if tpd_use_smt_filter
            bull_tpd := bull_tpd and bull_smt
            bear_tpd := bear_tpd and bear_smt

        if bear_tpd and tpd_show_icons
            lblbear := label.new(mh1t, mh1, text=f_text(_htf)+ '\n' + tpd_bear_shape, xloc=xloc.bar_time, yloc=yloc.abovebar, color=color.new(color.gray, 100), size=_size, textcolor=tpd_bear_color, tooltip="Bearish TPD (Structure)", text_font_family = target_font)
            array.push(tpd_labels, lblbear)
            if array.size(tpd_labels) > max_tpd_bars
                label.delete(array.shift(tpd_labels))
        if bull_tpd and tpd_show_icons
            lblbull := label.new(ml1t, ml1, text=tpd_bull_shape + '\n'+ f_text(_htf) , xloc=xloc.bar_time, yloc=yloc.belowbar, color=color.new(color.gray, 100), size=_size, textcolor=tpd_bull_color, tooltip="Bullish TPD (Structure)", text_font_family = target_font)
            array.push(tpd_labels, lblbull)
            if array.size(tpd_labels) > max_tpd_bars
                label.delete(array.shift(tpd_labels))

        bear_tpd_out := bear_tpd, bull_tpd_out := bull_tpd

    [bull_tpd_out, bear_tpd_out]

// ---------------------------------------------------------------
// TPD EXECUTION
// ---------------------------------------------------------------
tf1_run = tf1ok and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(tf1)
tf2_run = tf2ok and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(tf2)
tf3_run = tf3ok and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(tf3)
tf0_run = tf0ok

tpd_active = use_tpd_adv and tpd_is_visible

[tf1_tpd_bull_t, tf1_tpd_bear_t] = f_tpd_triad(tf1, tpd_active and tf1_run and triad_ok, tpd_lbl_size)
[tf1_tpd_bull_d, tf1_tpd_bear_d] = f_tpd(tf1, tpd_active and tf1_run and not triad_ok, tpd_lbl_size)

[tf2_tpd_bull_t, tf2_tpd_bear_t] = f_tpd_triad(tf2, tpd_active and tf2_run and triad_ok, tpd_lbl_size)
[tf2_tpd_bull_d, tf2_tpd_bear_d] = f_tpd(tf2, tpd_active and tf2_run and not triad_ok, tpd_lbl_size)

[tf3_tpd_bull_t, tf3_tpd_bear_t] = f_tpd_triad(tf3, tpd_active and tf3_run and triad_ok, tpd_lbl_size)
[tf3_tpd_bull_d, tf3_tpd_bear_d] = f_tpd(tf3, tpd_active and tf3_run and not triad_ok, tpd_lbl_size)

[tf0_tpd_bull_t, tf0_tpd_bear_t] = f_tpd_triad(timeframe.period, tpd_active and tf0_run and triad_ok, tpd_lbl_size)
[tf0_tpd_bull_d, tf0_tpd_bear_d] = f_tpd(timeframe.period, tpd_active and tf0_run and not triad_ok, tpd_lbl_size)

tpd_bull_any = tf1_tpd_bull_t or tf1_tpd_bull_d or tf2_tpd_bull_t or tf2_tpd_bull_d or tf3_tpd_bull_t or tf3_tpd_bull_d or tf0_tpd_bull_t or tf0_tpd_bull_d
tpd_bear_any = tf1_tpd_bear_t or tf1_tpd_bear_d or tf2_tpd_bear_t or tf2_tpd_bear_d or tf3_tpd_bear_t or tf3_tpd_bear_d or tf0_tpd_bear_t or tf0_tpd_bear_d

// TPD BODY COLOR
tpd_body_color = tpd_show_body and tpd_active ? (tpd_bull_any ? tpd_bull_body : tpd_bear_any ? tpd_bear_body : na) : na
barcolor(tpd_body_color)

// ============================================
// TPD DEBUG WINDOW
// ============================================
var table tpd_debug_tbl = table.new(position.top_right, 2, 15, border_width=1)
[dbg_mh2,dbg_ml2,dbg_mc2,dbg_mo2,dbg_mt2,dbg_mh1,dbg_ml1,dbg_mc1,dbg_mo1,dbg_mt1,dbg_mh0,dbg_ml0,dbg_mc0,dbg_mo0,dbg_mt0,dbg_mup1,dbg_mdw1,dbg_ml1t,dbg_mh1t] = f_live_sym(close, open, high, low, time, timeframe.period)
[dbg_oh2,dbg_ol2,dbg_oc2,dbg_oo2,dbg_ot2,dbg_oh1,dbg_ol1,dbg_oc1,dbg_oo1,dbg_ot1,dbg_oh0,dbg_ol0,dbg_oc0,dbg_oo0,dbg_ot0,dbg_oup1,dbg_odw1,dbg_ol1t,dbg_oh1t] = f_live_sym(xc0, xo0, xh0, xl0, xt0, timeframe.period)
[dbg_ph2,dbg_pl2,dbg_pc2,dbg_po2,dbg_pt2,dbg_ph1,dbg_pl1,dbg_pc1,dbg_po1,dbg_pt1,dbg_ph0,dbg_pl0,dbg_pc0,dbg_po0,dbg_pt0,dbg_pup1,dbg_pdw1,dbg_pl1t,dbg_ph1t] = f_live_sym(yc0, yo0, yh0, yl0, yt0, timeframe.period)

if barstate.islast
    if show_tpd_debug
        sym_dbg = syminfo.ticker
        csym_dbg = f_short_sym(csym_raw)
        tsym3_dbg = f_short_sym(tsym3_raw)
        use_triad_dbg = triad_ok
        use_dyad_dbg = not triad_ok and dyad_ok
        d_c1_main = dbg_mc1 > dbg_mo1
        d_c1_pair = dbg_oc1 > dbg_oo1
        d_c1_third = dbg_pc1 > dbg_po1
        d_c3_main = dbg_mc2 > dbg_mo0
        d_c3_pair = dbg_oc2 > dbg_oo0
        d_c3_third = dbg_pc2 > dbg_po0

        d_crack1_d = not array.every(array.from(d_c1_main, d_c1_pair)) and array.some(array.from(d_c1_main, d_c1_pair))
        d_crack2_d = not array.every(array.from(d_c3_main, d_c3_pair)) and array.some(array.from(d_c3_main, d_c3_pair))
        d_crack1_t = not array.every(array.from(d_c1_main, d_c1_pair, d_c1_third)) and array.some(array.from(d_c1_main, d_c1_pair, d_c1_third))
        d_crack2_t = not array.every(array.from(d_c3_main, d_c3_pair, d_c3_third)) and array.some(array.from(d_c3_main, d_c3_pair, d_c3_third))

        d_con_low_d = array.some(array.from(array.min(array.from(dbg_ml2, dbg_ml1, dbg_ml0)) == dbg_ml1, array.min(array.from(dbg_ol2, dbg_ol1, dbg_ol0)) == dbg_ol1))
        d_con_high_d = array.some(array.from(array.max(array.from(dbg_mh2, dbg_mh1, dbg_mh0)) == dbg_mh1, array.max(array.from(dbg_oh2, dbg_oh1, dbg_oh0)) == dbg_oh1))
        d_con_low_t = array.some(array.from(array.min(array.from(dbg_ml2, dbg_ml1, dbg_ml0)) == dbg_ml1, array.min(array.from(dbg_ol2, dbg_ol1, dbg_ol0)) == dbg_ol1, array.min(array.from(dbg_pl2, dbg_pl1, dbg_pl0)) == dbg_pl1))
        d_con_high_t = array.some(array.from(array.max(array.from(dbg_mh2, dbg_mh1, dbg_mh0)) == dbg_mh1, array.max(array.from(dbg_oh2, dbg_oh1, dbg_oh0)) == dbg_oh1, array.max(array.from(dbg_ph2, dbg_ph1, dbg_ph0)) == dbg_ph1))

        dbg_crack1 = use_triad_dbg ? d_crack1_t : d_crack1_d
        dbg_crack2 = use_triad_dbg ? d_crack2_t : d_crack2_d
        dbg_con_low = use_triad_dbg ? d_con_low_t : d_con_low_d
        dbg_con_high = use_triad_dbg ? d_con_high_t : d_con_high_d
        dbg_bear = dbg_con_high and dbg_crack1 and dbg_crack2
        dbg_bull = dbg_con_low and dbg_crack1 and dbg_crack2

        triad_r1 = use_triad_dbg ? sym_dbg : ""
        triad_r2 = use_triad_dbg ? csym_dbg : ""
        triad_r3 = use_triad_dbg ? tsym3_dbg : ""
        dyad_r1 = use_dyad_dbg ? sym_dbg : ""
        dyad_r2 = use_dyad_dbg ? csym_dbg : ""
        dyad_r3 = ""

        c1_a = sym_dbg + " C1 " + f_fmt(dbg_mo2) + "/" + f_fmt(dbg_mc2)
        c1_b = csym_dbg + " C1 " + f_fmt(dbg_oo2) + "/" + f_fmt(dbg_oc2)
        c1_c = tsym3_dbg + " C1 " + f_fmt(dbg_po2) + "/" + f_fmt(dbg_pc2)
        c2_a = sym_dbg + " C2 " + f_fmt(dbg_mo1) + "/" + f_fmt(dbg_mc1)
        c2_b = csym_dbg + " C2 " + f_fmt(dbg_oo1) + "/" + f_fmt(dbg_oc1)
        c2_c = tsym3_dbg + " C2 " + f_fmt(dbg_po1) + "/" + f_fmt(dbg_pc1)
        c3_a = sym_dbg + " C3 " + f_fmt(dbg_mo0) + "/" + f_fmt(dbg_mc0)
        c3_b = csym_dbg + " C3 " + f_fmt(dbg_oo0) + "/" + f_fmt(dbg_oc0)
        c3_c = tsym3_dbg + " C3 " + f_fmt(dbg_po0) + "/" + f_fmt(dbg_pc0)

        triad_c1_a = use_triad_dbg ? c1_a : ""
        triad_c1_b = use_triad_dbg ? c1_b : ""
        triad_c1_c = use_triad_dbg ? c1_c : ""
        triad_c2_a = use_triad_dbg ? c2_a : ""
        triad_c2_b = use_triad_dbg ? c2_b : ""
        triad_c2_c = use_triad_dbg ? c2_c : ""
        triad_c3_a = use_triad_dbg ? c3_a : ""
        triad_c3_b = use_triad_dbg ? c3_b : ""
        triad_c3_c = use_triad_dbg ? c3_c : ""

        dyad_c1_a = use_dyad_dbg ? c1_a : ""
        dyad_c1_b = use_dyad_dbg ? c1_b : ""
        dyad_c1_c = ""
        dyad_c2_a = use_dyad_dbg ? c2_a : ""
        dyad_c2_b = use_dyad_dbg ? c2_b : ""
        dyad_c2_c = ""
        dyad_c3_a = use_dyad_dbg ? c3_a : ""
        dyad_c3_b = use_dyad_dbg ? c3_b : ""
        dyad_c3_c = ""

        dbg_flags = (use_triad_dbg or use_dyad_dbg) ? ("cr1 " + str.tostring(dbg_crack1) + " cr2 " + str.tostring(dbg_crack2) + " hi " + str.tostring(dbg_con_high) + " lo " + str.tostring(dbg_con_low) + " b " + str.tostring(dbg_bear) + " u " + str.tostring(dbg_bull)) : ""
        dbg_bull_opacity = "Bull Opacity " + str.tostring(100 - color.t(tpd_bull_color))
        dbg_bear_opacity = "Bear Opacity " + str.tostring(100 - color.t(tpd_bear_color))
        header_bg = color.new(color.gray, 85)
        body_bg = color.white
        table.cell(tpd_debug_tbl, 0, 0, "Triad", text_color=color.black, bgcolor=header_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 1, 0, "Dyad", text_color=color.black, bgcolor=header_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 1, triad_r1, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 2, triad_r2, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 3, triad_r3, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 4, triad_c1_a, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 5, triad_c1_b, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 6, triad_c1_c, text_color=color.black, bgcolor=body_bg, text_size=size.small)
        table.cell(tpd_debug_tbl, 0, 7, triad_c2_a, text_color=color.black, bgcolor=body_bg, text_size=size.small)
