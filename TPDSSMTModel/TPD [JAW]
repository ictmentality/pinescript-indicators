tpd_bull_color = input.color(color.blue, "Bullish Icon", inline="tpd_style", group=group_tpd_adv)
tpd_bear_color = input.color(color.red, "Bearish Icon", inline="tpd_style", group=group_tpd_adv)

tpd_bull_shape = input.string("▲", "Shape", options=["●", "✦", "▲", "♦", "♟"], inline="tpd_icon", group=group_tpd_adv)
tpd_bear_shape = input.string("▼", "Shape", options=["●", "✦", "▼", "♦", "♟"], inline="tpd_icon", group=group_tpd_adv)

tpd_size_str = input.string("Tiny", "Size", options=["Tiny", "Small", "Normal", "Large", "Huge", "Auto"], inline="tpd_icon", group=group_tpd_adv)
tpd_lbl_size = switch tpd_size_str
